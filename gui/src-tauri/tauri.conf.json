{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IW Helper",
  "version": "1.0.0",
  "identifier": "fr.zen.iw-helper",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IW Helper",
        "width": 1000,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#161b21"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
